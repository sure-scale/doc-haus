{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "plugin/legal-v2.ts",
    "plugin/research-mcp.ts",
    "tool/register-v2.ts",
    "workflows/lean/*.ts"
  ]
}
