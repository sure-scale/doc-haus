{
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "types": [
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ],
    "noUncheckedIndexedAccess": false,
    "customConditions": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "script/**/*.ts"
  ]
}
