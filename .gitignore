# Generated demo letter: services/ingest seed.ts rebuilds it on every run and
# the docx library stamps core.xml with the current time, so a tracked copy
# only churns. Regenerate with `cd services/ingest && bun run seed`.
demo/Letter-of-Engagement-Aldgate-Mills.docx

